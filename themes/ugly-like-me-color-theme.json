{
  "$schema": "vscode://schemas/color-theme",
  "name": "Ugly Like Me",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#4A3F29",
    "editor.foreground": "#FFF84F",
    "editor.lineHighlightBackground": "#5E1F4A",
    "editor.selectionBackground": "#FF2E9366",
    "editorCursor.foreground": "#86FF64",
    "editorLineNumber.foreground": "#B9C1AA",
    "editorLineNumber.activeForeground": "#FF2E93",
    "editorIndentGuide.background1": "#DA0428",
    "editorIndentGuide.activeBackground1": "#86FF64",
    "editorWhitespace.foreground": "#B9C1AA",
    "editorError.foreground": "#FF2E2E",
    "editorWarning.foreground": "#3DF5FF",
    "editorInfo.foreground": "#FBB903",
    "editorGutter.addedBackground": "#86FF64",
    "editorGutter.deletedBackground": "#FF9494",
    "editorGutter.modifiedBackground": "#FBB903",
    "titleBar.activeBackground": "#FF2E93",
    "titleBar.activeForeground": "#0D042F",
    "titleBar.inactiveBackground": "#FF2E93",
    "titleBar.inactiveForeground": "#0D042F",
    "activityBar.background": "#86FF64",
    "activityBar.foreground": "#851287",
    "activityBar.inactiveForeground": "#85128799",
    "activityBarBadge.background": "#DA0428",
    "activityBarBadge.foreground": "#FFFFFF",
    "badge.background": "#DA0428",
    "badge.foreground": "#FFFFFF",
    "sideBar.background": "#851287",
    "sideBar.foreground": "#C8F1C7",
    "sideBarTitle.foreground": "#FFF84F",
    "sideBarSectionHeader.background": "#17646E",
    "sideBarSectionHeader.foreground": "#FFFFFF",
    "list.activeSelectionBackground": "#FFF84F",
    "list.activeSelectionForeground": "#0D042F",
    "list.hoverBackground": "#5E1F4A",
    "list.hoverForeground": "#FFF84F",
    "editorGroupHeader.tabsBackground": "#320059",
    "tab.activeBackground": "#FFF84F",
    "tab.activeForeground": "#0D042F",
    "tab.inactiveBackground": "#17646E",
    "tab.inactiveForeground": "#FFFFFF",
    "tab.border": "#DA0428",
    "tab.activeBorderTop": "#DA0428",
    "statusBar.background": "#FF6A00",
    "statusBar.foreground": "#0D042F",
    "statusBar.noFolderBackground": "#FF6A00",
    "statusBar.debuggingBackground": "#DA0428",
    "statusBar.debuggingForeground": "#FFFFFF",
    "panel.background": "#0D042F",
    "panel.border": "#DA0428",
    "panelTitle.activeForeground": "#86FF64",
    "terminal.background": "#0D042F",
    "terminal.foreground": "#86FF64",
    "input.background": "#C8F1C7",
    "input.foreground": "#320059",
    "dropdown.background": "#C8F1C7",
    "dropdown.foreground": "#320059",
    "button.background": "#DA0428",
    "button.foreground": "#FFF84F",
    "focusBorder": "#DA0428",
    "scrollbarSlider.background": "#FF2E9380",
    "scrollbarSlider.hoverBackground": "#86FF64",
    "scrollbarSlider.activeBackground": "#DA0428",
    "minimap.background": "#320059",
    "editorBracketHighlight.foreground1": "#FF85D0",
    "editorBracketHighlight.foreground2": "#86FF64",
    "editorBracketHighlight.foreground3": "#FBB903",
    "editorBracketHighlight.foreground4": "#3DF5FF",
    "editorBracketHighlight.foreground5": "#D59BFF",
    "editorBracketHighlight.foreground6": "#FF8C69",
    "terminal.ansiBlack": "#0D042F",
    "terminal.ansiRed": "#DA0428",
    "terminal.ansiGreen": "#86FF64",
    "terminal.ansiYellow": "#FFF84F",
    "terminal.ansiBlue": "#3D5AFE",
    "terminal.ansiMagenta": "#FF2E93",
    "terminal.ansiCyan": "#3DF5FF",
    "terminal.ansiWhite": "#C8F1C7",
    "terminal.ansiBrightBlack": "#57594E",
    "terminal.ansiBrightRed": "#FF2E2E",
    "terminal.ansiBrightGreen": "#B6FF9E",
    "terminal.ansiBrightYellow": "#FBB903",
    "terminal.ansiBrightBlue": "#8C9EFF",
    "terminal.ansiBrightMagenta": "#D59BFF",
    "terminal.ansiBrightCyan": "#A0FFFF",
    "terminal.ansiBrightWhite": "#FFFFFF"
  },
  "semanticTokenColors": {
    "variable.readonly": {
      "foreground": "#FBB903"
    },
    "parameter": {
      "foreground": "#FBB903",
      "italic": true
    },
    "property": "#C8F1C7",
    "function": {
      "foreground": "#D59BFF",
      "bold": true
    },
    "method": {
      "foreground": "#D59BFF",
      "bold": true
    },
    "class": "#ECB980",
    "interface": {
      "foreground": "#ECB980",
      "italic": true
    },
    "enumMember": "#FBB903",
    "type": "#ECB980",
    "namespace": "#ECB980",
    "decorator": {
      "foreground": "#D59BFF",
      "italic": true,
      "underline": true
    },
    "*.deprecated": {
      "strikethrough": true
    },
    "*.defaultLibrary": {
      "italic": true
    }
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#FF85D0",
        "fontStyle": "italic bold underline"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#3DF5FF"
      }
    },
    {
      "name": "Storage",
      "scope": [
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#3DF5FF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Operator, Punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#A8D86E"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "constant.other.symbol",
        "string constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#86FF64"
      }
    },
    {
      "name": "Escape, Regexp",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#A8D86E",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Number, Constant",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "support.constant",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#FBB903"
      }
    },
    {
      "name": "Colors",
      "scope": [
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#FBB903",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "support.other.variable"
      ],
      "settings": {
        "foreground": "#FF8C69"
      }
    },
    {
      "name": "Language Variable (this, self)",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#3DF5FF",
        "fontStyle": "italic bold underline"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#FBB903",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "variable.function",
        "support.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#D59BFF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Method Definition",
      "scope": [
        "entity.name.method",
        "meta.class-method entity.name.function"
      ],
      "settings": {
        "foreground": "#D59BFF",
        "fontStyle": "italic bold underline"
      }
    },
    {
      "name": "Class, Type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#ECB980"
      }
    },
    {
      "name": "Decorator",
      "scope": [
        "meta.decorator",
        "tag.decorator.js entity.name.tag.js",
        "tag.decorator.js punctuation.definition.tag.js"
      ],
      "settings": {
        "foreground": "#D59BFF",
        "fontStyle": "italic bold underline"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#C8F1C7"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml"
      ],
      "settings": {
        "foreground": "#86FF64",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tag Punctuation",
      "scope": [
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#A8D86E"
      }
    },
    {
      "name": "Attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#FBB903",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS Class, ID",
      "scope": [
        "entity.other.attribute-name.class",
        "entity.other.attribute-name.id"
      ],
      "settings": {
        "foreground": "#ECB980",
        "fontStyle": "italic bold underline"
      }
    },
    {
      "name": "CSS Property",
      "scope": [
        "source.css support.type.property-name",
        "source.scss support.type.property-name",
        "source.sass support.type.property-name",
        "source.less support.type.property-name"
      ],
      "settings": {
        "foreground": "#C8F1C7"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "fontStyle": "italic bold underline"
      }
    },
    {
      "name": "URL",
      "scope": [
        "*url*",
        "*link*",
        "*uri*"
      ],
      "settings": {
        "foreground": "#3DF5FF",
        "fontStyle": "underline"
      }
    },
    {
      "name": "JSON Key - Level 0",
      "scope": [
        "source.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#FF85D0"
      }
    },
    {
      "name": "JSON Key - Level 1",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#86FF64"
      }
    },
    {
      "name": "JSON Key - Level 2",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#FBB903"
      }
    },
    {
      "name": "JSON Key - Level 3",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#3DF5FF"
      }
    },
    {
      "name": "JSON Key - Level 4",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#D59BFF"
      }
    },
    {
      "name": "JSON Key - Level 5",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#FF8C69"
      }
    },
    {
      "name": "Inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#86FF64"
      }
    },
    {
      "name": "Deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#FF9494",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#FBB903"
      }
    },
    {
      "name": "Markdown Heading",
      "scope": [
        "markup.heading",
        "markup.heading entity.name",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#FF85D0",
        "fontStyle": "italic bold underline"
      }
    },
    {
      "name": "Markdown Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#FBB903",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#ECB980",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Bold Italic",
      "scope": [
        "markup.bold markup.italic",
        "markup.italic markup.bold"
      ],
      "settings": {
        "foreground": "#D59BFF",
        "fontStyle": "italic bold"
      }
    },
    {
      "name": "Markdown Underline",
      "scope": [
        "markup.underline"
      ],
      "settings": {
        "foreground": "#FBB903",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown Strikethrough",
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "foreground": "#FF85D0",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markdown Quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#C8F1C7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Inline Code",
      "scope": [
        "markup.inline.raw",
        "markup.raw.block"
      ],
      "settings": {
        "foreground": "#86FF64"
      }
    },
    {
      "name": "Markdown Fence",
      "scope": [
        "punctuation.definition.fenced.markdown",
        "punctuation.definition.raw.markdown"
      ],
      "settings": {
        "foreground": "#A8D86E"
      }
    },
    {
      "name": "Markdown Fence Language",
      "scope": [
        "fenced_code.block.language"
      ],
      "settings": {
        "foreground": "#3DF5FF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Link Text",
      "scope": [
        "string.other.link.title.markdown",
        "string.other.link.description.markdown"
      ],
      "settings": {
        "foreground": "#3DF5FF",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown Link URL",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#FBB903"
      }
    },
    {
      "name": "Markdown List Bullet",
      "scope": [
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": "#FF85D0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Separator",
      "scope": [
        "meta.separator"
      ],
      "settings": {
        "foreground": "#FF85D0",
        "fontStyle": "italic bold underline"
      }
    }
  ]
}
